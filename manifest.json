{
 "manifest_version":3,"name":"PDP Health Check by Magenable","version":"0.2.0",
 "description":"Check product pages for SEO, structured data, AI discoverability readiness and conversion opportunities.",
 "minimum_chrome_version":"116","incognito":"not_allowed","permissions":["activeTab","scripting","sidePanel","storage"],
 "action":{"default_title":"Open PDP Health Check","default_icon":{"16":"icon-16.png","32":"icon-32.png"}},
